generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Ticker {
  id           String   @id @default(uuid()) @db.Uuid
  symbol       String   @unique @db.VarChar(20)
  secType      String   @default("STK") @map("sec_type") @db.VarChar(10)
  status       String   @default("active") @db.VarChar(20)
  source       String   @default("manual") @map("source") @db.VarChar(20)
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz()
  lastAnalyzed DateTime? @map("last_analyzed") @db.Timestamptz()

  dataCollections DataCollection[]
  analyses        Analysis[]
  reports         Report[]

  @@map("ticker")
}

model DataCollection {
  id          String   @id @default(uuid()) @db.Uuid
  tickerId    String   @map("ticker_id") @db.Uuid
  source      String   @db.VarChar(30)
  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz()
  status      String   @default("ok") @db.VarChar(10)
  data        Json?    @db.JsonB
  skipReason  String?  @map("skip_reason")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()

  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@index([tickerId, source])
  @@index([expiresAt])
  @@map("data_collection")
}

model Analysis {
  id         String   @id @default(uuid()) @db.Uuid
  tickerId   String   @map("ticker_id") @db.Uuid
  source     String   @db.VarChar(30)
  analyzedAt DateTime @default(now()) @map("analyzed_at") @db.Timestamptz()
  signal     String   @db.VarChar(10)
  confidence Float
  summary    String
  details    Json     @db.JsonB

  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@index([tickerId, source])
  @@map("analysis")
}

model Report {
  id             String   @id @default(uuid()) @db.Uuid
  tickerId       String   @map("ticker_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  recommendation String   @db.VarChar(20)
  confidence     Float
  summary        String
  fullReport     String   @map("full_report")
  analysisIds    String[] @map("analysis_ids") @db.Uuid

  ticker Ticker @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@index([tickerId])
  @@map("report")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(50)
  symbol      String?   @db.VarChar(20)
  status      String    @default("queued") @db.VarChar(20)
  progress    String?
  result      Json?     @db.JsonB
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  @@index([status])
  @@index([symbol])
  @@map("job")
}

model ScreenerConfig {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @db.VarChar(100)
  criteria Json      @db.JsonB
  schedule String    @db.VarChar(50)
  enabled  Boolean   @default(true)
  lastRun  DateTime? @map("last_run") @db.Timestamptz()

  @@map("screener_config")
}

model MacroSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  analyzedAt DateTime @default(now()) @map("analyzed_at") @db.Timestamptz()
  regime     String   @db.VarChar(20)
  confidence Float
  summary    String
  details    Json     @db.JsonB

  @@map("macro_snapshot")
}
