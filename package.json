{
  "name": "assup",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Asset allocation portfolio manager - Monorepo",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@assup/shared",
    "dev:backend": "npm run dev --workspace=assup-backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "postinstall": "npm run build:shared",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "guard:scan": "node scripts/guard/scan.mjs --tree",
    "guard:refresh": "node scripts/guard/refresh-denylist.mjs",
    "guard:test": "node --test scripts/guard/*.test.mjs"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide": "^4.1.17",
    "esbuild": "^0.27.2",
    "lightningcss": "^1.30.2",
    "rollup": "^4.56.0"
  },
  "devDependencies": {
    "typescript": "^5.3.2"
  }
}
