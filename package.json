{
  "name": "assup",
  "private": true,
  "version": "1.0.0",
  "description": "Asset allocation portfolio manager - Monorepo",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "desktop",
    "research"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace=@assup/shared",
    "dev:backend": "npm run dev --workspace=assup-backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "postinstall": "npm run build:shared"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide": "^4.1.17",
    "esbuild": "^0.27.2",
    "lightningcss": "^1.30.2",
    "rollup": "^4.56.0"
  },
  "devDependencies": {
    "typescript": "^5.3.2"
  }
}
