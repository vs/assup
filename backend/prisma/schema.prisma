// Prisma schema for Assup - Asset Allocation Manager

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Asset Classes - user-defined categories for investments
model AssetClass {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  color       String   @default("#6366f1") @db.VarChar(7)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  allocationTargets   AllocationTarget[]
  securityAssignments SecurityAssignment[]

  @@map("asset_classes")
}

// Allocation Profiles - named sets of target allocations
model AllocationProfile {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  targets AllocationTarget[]

  @@map("allocation_profiles")
}

// Allocation Targets - percentage targets for each asset class in a profile
model AllocationTarget {
  id                  String @id @default(uuid()) @db.Uuid
  allocationProfileId String @map("allocation_profile_id") @db.Uuid
  assetClassId        String @map("asset_class_id") @db.Uuid
  targetPercentage    Float  @map("target_percentage") @db.DoublePrecision

  // Relations
  allocationProfile AllocationProfile @relation(fields: [allocationProfileId], references: [id], onDelete: Cascade)
  assetClass        AssetClass        @relation(fields: [assetClassId], references: [id], onDelete: Cascade)

  @@unique([allocationProfileId, assetClassId])
  @@map("allocation_targets")
}

// Security Assignments - maps symbols to asset classes
model SecurityAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  symbol       String   @db.VarChar(20)
  conId        Int?     @map("con_id")
  secType      String   @default("STK") @map("sec_type") @db.VarChar(10)
  assetClassId String   @map("asset_class_id") @db.Uuid
  source       String   @default("position") @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  assetClass AssetClass @relation(fields: [assetClassId], references: [id], onDelete: Cascade)

  @@unique([symbol, secType])
  @@index([symbol])
  @@index([assetClassId])
  @@map("security_assignments")
}

// Watchlists - user-curated lists of securities
model Watchlist {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  items    WatchlistItem[]
  scanRuns ScanRun[]

  @@map("watchlists")
}

// Watchlist Items - individual securities in a watchlist
model WatchlistItem {
  id             String    @id @default(uuid()) @db.Uuid
  watchlistId    String    @map("watchlist_id") @db.Uuid
  symbol         String    @db.VarChar(20)
  conId          Int?      @map("con_id")
  secType        String    @default("STK") @map("sec_type") @db.VarChar(10)
  addedAt        DateTime  @default(now()) @map("added_at") @db.Timestamptz
  source         String    @default("manual") @map("source") @db.VarChar(20)
  lastAnalyzedAt DateTime? @map("last_analyzed_at") @db.Timestamptz
  sortOrder      Int       @default(0) @map("sort_order")

  // Relations
  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
  @@map("watchlist_items")
}

// Scanner Presets - saved scanner criteria configurations
model ScannerPreset {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  criteria  Json     @db.JsonB
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("scanner_presets")
}

// Scan Jobs - tracks background scanner executions with results
model ScanJob {
  id               String    @id @default(uuid()) @db.Uuid
  presetId         String?   @map("preset_id") @db.Uuid
  presetName       String    @map("preset_name") @db.VarChar(100)
  criteria         Json      @db.JsonB
  status           String    @db.VarChar(20) // running, completed, failed, cancelled

  // Progress tracking
  totalSymbols     Int       @default(0) @map("total_symbols")
  scannedSymbols   Int       @default(0) @map("scanned_symbols")
  opportunityCount Int       @default(0) @map("opportunity_count")
  bestAnnualReturn Float?    @map("best_annual_return") @db.DoublePrecision
  bestPremiumPct   Float?    @map("best_premium_pct") @db.DoublePrecision

  // Results stored as JSON array of OptionOpportunity
  opportunities    Json      @default("[]") @db.JsonB

  // Lifecycle timestamps
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz

  // Error info
  errorMessage     String?   @map("error_message") @db.Text

  @@index([status])
  @@index([expiresAt])
  @@map("scan_jobs")
}

// Settings - key-value store for application settings
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(50)
  value     Json     @db.JsonB
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

// Import Batches - tracks each Flex Query file import for deduplication
model ImportBatch {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String   @db.VarChar(255)
  importedAt  DateTime @default(now()) @map("imported_at") @db.Timestamptz
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  recordCount Int      @map("record_count")
  fileHash    String   @map("file_hash") @db.VarChar(64)

  // Relations
  trades           ImportedTrade[]
  cashTransactions CashTransaction[]
  corporateActions CorporateAction[]
  flexFetchLog     FlexFetchLog?
  accountSnapshots AccountSnapshot[]
  fundFlows        FundFlow[]

  @@index([fileHash])
  @@map("import_batches")
}

// Imported Trades - options and stock trades from Flex Query
model ImportedTrade {
  id            String   @id @default(uuid()) @db.Uuid
  importBatchId String   @map("import_batch_id") @db.Uuid
  tradeId       String   @unique @map("trade_id") @db.VarChar(100)

  // Security info
  symbol      String  @db.VarChar(50)
  description String? @db.Text
  conId       Int?    @map("con_id")
  secType     String  @map("sec_type") @db.VarChar(10) // STK, OPT

  // Option-specific fields
  strike     Float?    @db.DoublePrecision
  expiry     DateTime? @db.Date
  right      String?   @db.VarChar(1) // C or P
  underlying String?   @db.VarChar(50)
  multiplier Int       @default(100)

  // Transaction details
  tradeDate  DateTime @map("trade_date") @db.Date
  quantity   Float    @db.DoublePrecision
  tradePrice Float    @map("trade_price") @db.DoublePrecision
  proceeds   Float    @db.DoublePrecision
  commission Float    @default(0) @db.DoublePrecision
  buySell    String   @map("buy_sell") @db.VarChar(10)
  openClose  String?  @map("open_close") @db.VarChar(10)

  // IBKR cost basis and realized P&L (for sells without matching buys in import)
  costBasis   Float? @map("cost_basis") @db.DoublePrecision
  realizedPnl Float? @map("realized_pnl") @db.DoublePrecision

  // Assignment tracking (computed after import)
  wasAssigned    Boolean   @default(false) @map("was_assigned")
  assignmentDate DateTime? @map("assignment_date") @db.Date

  // Currency for tax calculations
  currency String @default("USD") @db.VarChar(3)

  // Relations
  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@index([tradeDate])
  @@index([expiry])
  @@index([secType])
  @@index([underlying])
  @@map("imported_trades")
}

// Cash Transactions - dividends, interest, fees from Flex Query
model CashTransaction {
  id            String @id @default(uuid()) @db.Uuid
  importBatchId String @map("import_batch_id") @db.Uuid
  transactionId String @unique @map("transaction_id") @db.VarChar(50)

  // Transaction info
  symbol      String?  @db.VarChar(20)
  description String   @db.Text
  conId       Int?     @map("con_id")

  // Transaction details
  transactionDate DateTime @map("transaction_date") @db.Date
  amount          Float    @db.DoublePrecision
  currency        String   @default("USD") @db.VarChar(3)
  type            String   @db.VarChar(30) // DIVIDEND, INTEREST, WITHHOLDING_TAX, etc.

  // Relations
  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([transactionDate])
  @@index([symbol])
  @@map("cash_transactions")
}

// Exchange Rates - cached CNB daily exchange rates for tax calculations
model ExchangeRate {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  currency  String   @db.VarChar(3)
  rate      Decimal  @db.Decimal(10, 4)
  source    String   @default("CNB")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([date, currency])
  @@index([date])
  @@index([currency])
  @@map("exchange_rates")
}

// Wheel Trackers - tickers being tracked for wheel strategy
model WheelTracker {
  id        String    @id @default(uuid()) @db.Uuid
  symbol    String    @unique @db.VarChar(20)
  startDate DateTime? @map("start_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("wheel_trackers")
}

// Wheel Suggestion Dismissals - hidden suggestions
model WheelSuggestionDismissal {
  id          String   @id @default(uuid()) @db.Uuid
  symbol      String   @unique @db.VarChar(20)
  dismissedAt DateTime @default(now()) @map("dismissed_at") @db.Timestamptz

  @@map("wheel_suggestion_dismissals")
}

// Wheel Summary Cache - precomputed summaries for faster list rendering
model WheelSummaryCache {
  id            String    @id @default(uuid()) @db.Uuid
  symbol        String    @unique @db.VarChar(20)
  startDate     DateTime? @map("start_date") @db.Date
  tradeCount    Int       @map("trade_count")
  lastTradeDate DateTime? @map("last_trade_date") @db.Date

  // Dividends move the summary without touching trades, so they invalidate too.
  dividendCount    Int       @default(0) @map("dividend_count")
  lastDividendDate DateTime? @map("last_dividend_date") @db.Date
  summary       Json
  computedAt    DateTime  @default(now()) @map("computed_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("wheel_summary_cache")
}

// Corporate Actions - stock splits, mergers, spinoffs from FLEX Query
model CorporateAction {
  id            String   @id @default(uuid()) @db.Uuid
  importBatchId String   @map("import_batch_id") @db.Uuid
  actionId      String   @unique @map("action_id") @db.VarChar(100)

  // Security info
  symbol      String  @db.VarChar(50)
  description String? @db.Text
  conId       Int?    @map("con_id")

  // Action details
  actionType String   @map("action_type") @db.VarChar(20) // FS (forward split), RS (reverse split), SD (stock dividend), TC (ticker change), etc.
  exDate     DateTime @map("ex_date") @db.Date
  payDate    DateTime? @map("pay_date") @db.Date

  // For splits: quantity received (e.g., +90 for 10:1 split on 10 shares)
  // For ticker changes: 0
  quantity   Float    @db.DoublePrecision
  value      Float    @default(0) @db.DoublePrecision

  // Computed ratio for splits (e.g., 10 for 10:1 split)
  // Calculated as: (original_shares + quantity) / original_shares
  // Or can be parsed from description
  splitRatio Float?   @map("split_ratio") @db.DoublePrecision

  // Relations
  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@index([exDate])
  @@index([actionType])
  @@map("corporate_actions")
}

// Flex Fetch Logs - track FLEX report fetch operations
model FlexFetchLog {
  id            String   @id @default(uuid()) @db.Uuid
  triggeredBy   String   @map("triggered_by") @db.VarChar(20)
  status        String   @db.VarChar(20)
  startedAt     DateTime @map("started_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz
  recordCount   Int?     @map("record_count")
  error         String?  @db.Text
  importBatchId String?  @unique @map("import_batch_id") @db.Uuid
  details       Json?    @db.JsonB

  // Relations
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([startedAt])
  @@map("flex_fetch_logs")
}

// ============================================================
// Research models (merged from research microservice)
// ============================================================

// Data Collections - raw collected market data per source
model DataCollection {
  id          String    @id @default(uuid()) @db.Uuid
  symbol      String    @db.VarChar(20)
  source      String    @db.VarChar(30)
  collectedAt DateTime  @default(now()) @map("collected_at") @db.Timestamptz()
  status      String    @default("ok") @db.VarChar(10)
  data        Json?     @db.JsonB
  skipReason  String?   @map("skip_reason")
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz()

  @@index([symbol, source])
  @@index([expiresAt])
  @@map("data_collection")
}

// Analysis - analysis results with signal, confidence, and details
model Analysis {
  id         String   @id @default(uuid()) @db.Uuid
  symbol     String   @db.VarChar(20)
  source     String   @db.VarChar(30)
  analyzedAt DateTime @default(now()) @map("analyzed_at") @db.Timestamptz()
  signal     String   @db.VarChar(10)
  confidence Float
  summary    String
  details    Json     @db.JsonB

  @@index([symbol, source])
  @@map("analysis")
}

// Research Reports - synthesized research reports with recommendations
model ResearchReport {
  id              String   @id @default(uuid()) @db.Uuid
  symbol          String   @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  recommendation  String   @db.VarChar(20)
  confidence      Float
  summary         String
  fullReport      String   @map("full_report")
  analysisIds     String[] @map("analysis_ids") @db.Uuid
  companyOverview Json?    @map("company_overview")

  @@index([symbol])
  @@map("research_report")
}

// Research Jobs - async job tracking for long-running operations
model ResearchJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(50)
  symbol      String?   @db.VarChar(20)
  status      String    @default("queued") @db.VarChar(20)
  progress    String?
  result      Json?     @db.JsonB
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  startedAt   DateTime? @map("started_at") @db.Timestamptz()
  completedAt DateTime? @map("completed_at") @db.Timestamptz()

  @@index([status])
  @@index([symbol])
  @@map("research_job")
}

// Market Scanner Preset - TWS market scanner configurations and schedules
model MarketScannerPreset {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(100)
  scanCode        String    @map("scan_code") @db.VarChar(60)
  locationCode    String    @default("STK.US.MAJOR") @map("location_code") @db.VarChar(40)
  filters         Json      @default("{}") @db.JsonB
  technicalFilter Json      @default("{}") @map("technical_filter") @db.JsonB
  schedule        String    @db.VarChar(50)
  enabled         Boolean   @default(true)
  lastRun         DateTime? @map("last_run") @db.Timestamptz()

  @@map("market_scanner_preset")
}

// Scan Run - persists each scanner execution with metadata and results
model ScanRun {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(200)
  scanCode        String    @map("scan_code") @db.VarChar(60)
  locationCode    String    @default("STK.US.MAJOR") @map("location_code") @db.VarChar(40)
  filters         Json      @default("{}") @db.JsonB
  technicalFilter Json      @default("{}") @map("technical_filter") @db.JsonB
  symbols         String[]
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  watchlistId     String?   @map("watchlist_id") @db.Uuid

  watchlist Watchlist? @relation(fields: [watchlistId], references: [id], onDelete: SetNull)

  @@map("scan_runs")
}

// Macro Snapshot - macro regime analysis snapshots
model MacroSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  analyzedAt DateTime @default(now()) @map("analyzed_at") @db.Timestamptz()
  regime     String   @db.VarChar(20)
  confidence Float
  summary    String
  details    Json     @db.JsonB

  @@map("macro_snapshot")
}

model TickerProfile {
  symbol         String   @id @db.VarChar(20)
  companyName    String   @map("company_name") @db.VarChar(255)
  description    String   @db.Text
  sector         String?  @db.VarChar(255)
  industry       String?  @db.VarChar(255)
  marketPosition String?  @map("market_position") @db.Text
  marketCap      Float?   @map("market_cap") @db.DoublePrecision
  peRatio        Float?   @map("pe_ratio") @db.DoublePrecision
  dividendYield  Float?   @map("dividend_yield") @db.DoublePrecision
  currentPrice   Float?   @map("current_price") @db.DoublePrecision
  previousClose  Float?   @map("previous_close") @db.DoublePrecision
  fetchedAt      DateTime @map("fetched_at") @db.Timestamptz
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  @@map("ticker_profile")
}

model PriceHistoryCache {
  symbol    String   @id @db.VarChar(20)
  data      Json     @db.JsonB
  period    String   @db.VarChar(10)
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  @@map("price_history_cache")
}

model CalendarEvent {
  id        String   @id @default(uuid()) @db.Uuid
  eventType String   @map("event_type") @db.VarChar(30)
  symbol    String?  @db.VarChar(20)
  date      DateTime @db.Date
  title     String   @db.Text
  details   Json?    @db.JsonB
  source    String   @db.VarChar(20)
  sourceId  String?  @map("source_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([source, sourceId])
  @@index([date])
  @@index([symbol, date])
  @@index([eventType, date])
  @@map("calendar_event")
}

model CalendarSyncStatus {
  id         String   @id @default(uuid()) @db.Uuid
  source     String   @db.VarChar(20)
  symbol     String?  @db.VarChar(20)
  lastSyncAt DateTime @map("last_sync_at") @db.Timestamptz
  nextSyncAt DateTime @map("next_sync_at") @db.Timestamptz

  @@unique([source, symbol])
  @@map("calendar_sync_status")
}

model AccountSnapshot {
  id              String      @id @default(uuid()) @db.Uuid
  date            DateTime    @unique @db.Date
  netLiquidation  Float       @map("net_liquidation") @db.DoublePrecision
  currency        String      @default("USD") @db.VarChar(10)
  importBatchId   String      @map("import_batch_id") @db.Uuid
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("account_snapshots")
}

model FundFlow {
  id              String      @id @default(uuid()) @db.Uuid
  transactionId   String      @unique @map("transaction_id") @db.VarChar(255)
  date            DateTime    @db.Date
  type            String      @db.VarChar(20)
  amount          Float       @db.DoublePrecision
  currency        String      @default("USD") @db.VarChar(10)
  description     String
  importBatchId   String      @map("import_batch_id") @db.Uuid
  importBatch     ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([type])
  @@map("fund_flows")
}

// Dividend Report Uploads - per-year IBKR Dividend Report CSV imports.
// One upload per (account, taxYear). Re-uploading a year replaces prior records.
model DividendReportUpload {
  id            String   @id @default(uuid()) @db.Uuid
  filename      String   @db.VarChar(255)
  uploadedAt    DateTime @default(now()) @map("uploaded_at") @db.Timestamptz
  fileHash      String   @map("file_hash") @db.VarChar(64)
  accountNumber String?  @map("account_number") @db.VarChar(50)
  taxYear       Int      @map("tax_year")
  recordCount   Int      @map("record_count")

  records DividendReportRecord[]

  @@index([fileHash])
  @@index([taxYear])
  @@map("dividend_report_uploads")
}

// Dividend Report Records - one row per RevenueComponent (post-reclassification).
// Keyed by (symbol, payDate) for joining with CashTransaction at tax-calc time.
model DividendReportRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  uploadId           String   @map("upload_id") @db.Uuid

  symbol             String   @db.VarChar(50)
  conId              Int?     @map("con_id")
  country            String?  @db.VarChar(2)
  payDate            DateTime @map("pay_date") @db.Date
  exDate             DateTime? @map("ex_date") @db.Date
  shares             Float?

  // Raw IBKR classification, verbatim from CSV.
  revenueComponent   String   @map("revenue_component") @db.VarChar(120)
  qualifiedIndicator String?  @map("qualified_indicator") @db.VarChar(80)

  // Mapped bucket: DIVIDEND, INTEREST, CAPITAL_GAIN, ROC, PIL.
  // Stored (not computed) so a future mapping change does not restate old reports.
  taxCategory        String   @map("tax_category") @db.VarChar(20)

  currency           String   @db.VarChar(3)
  grossUsd           Float    @map("gross_usd")    @db.DoublePrecision
  withholdUsd        Float    @map("withhold_usd") @db.DoublePrecision

  upload DividendReportUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([symbol, payDate])
  @@index([payDate])
  @@map("dividend_report_records")
}
