# Copy to .env and fill in what you need. Only DATABASE_URL is required.

# --- Database ---
DB_PASSWORD=assup_dev
DATABASE_URL=postgresql://assup:assup_dev@localhost:5432/assup

# --- Interactive Brokers TWS / IB Gateway ---
# 7496 = live trading, 7497 = paper trading. Start with paper.
IB_HOST=127.0.0.1
IB_PORT=7497
# IB_CLIENT_ID=1
# IB_MARKET_DATA_LINES=100

# --- Market data (optional) ---
# Polygon.io — company profiles, price history, research collectors. Free tier: 5 req/min.
MARKET_DATA_API_KEY=
# POLYGON_RATE_LIMIT_RPM=5
# Finnhub — earnings calendar (https://finnhub.io/). Free tier: 60 calls/minute.
FINNHUB_API_KEY=
# Seeking Alpha via RapidAPI — ratings and comments.
SA_RAPIDAPI_KEY=
# Reddit — social sentiment collector.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Research report synthesis (optional) ---
# "claude-cli" uses a Claude Code login (CLAUDE_CODE_OAUTH_TOKEN or CLAUDE_CONFIG_DIR);
# "api" uses ANTHROPIC_API_KEY.
SYNTHESIZER_MODE=claude-cli
CLAUDE_CONFIG_DIR=~/.claude
# CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# --- Scheduling ---
# Enables scheduled research, market scans and FLEX Web Service auto-import.
SCHEDULER_ENABLED=false
